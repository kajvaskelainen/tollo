<Window x:Class="Kanava.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Kanava.Views"
        xmlns:vm="clr-namespace:Kanava.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Töllö" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
            <views:FavoritesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoviesViewModel}">
            <views:MoviesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeriesViewModel}">
            <views:SeriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sys:String}">
            <TextBlock Text="{Binding}" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Kirjautuminen -->
        <views:LoginView DataContext="{Binding Login}"
                         Visibility="{Binding DataContext.IsLoggedIn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=!}" />

        <!-- Sovellus -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sivupalkki ===== -->
            <DockPanel x:Name="Sidebar" Width="184" Background="{StaticResource SidebarBrush}">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,22">
                    <Image Source="/Assets/Tollo.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Töllö" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Profiili -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,18" Padding="10" CornerRadius="8" Background="{StaticResource PanelBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Session.Account.Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Session.Account.ExpiresAt, StringFormat=Voimassa {0:d.M.yyyy}, TargetNullValue=Aktiivinen}"
                                       FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Alavalikko -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Asetukset"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
                    <Button Command="{Binding LogoutCommand}" Margin="10,2" Cursor="Hand" AutomationProperties.Name="Kirjaudu ulos">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="i" Text="&#xF3B1;" Style="{StaticResource Icon}" Margin="0,0,12,0" Foreground="{StaticResource TextDimBrush}" />
                                        <TextBlock x:Name="t" Text="Kirjaudu ulos" FontSize="14" Foreground="{StaticResource TextDimBrush}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="i" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Päävalikko -->
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE721;" Content="Haku"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource Equals}, ConverterParameter=Search}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="Live TV"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource Equals}, ConverterParameter=LiveTv}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8B2;" Content="Elokuvat"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource Equals}, ConverterParameter=Movies}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8A9;" Content="Sarjat"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource Equals}, ConverterParameter=Series}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEB51;" Content="Suosikit"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource Equals}, ConverterParameter=Favorites}" />
                </StackPanel>
            </DockPanel>

            <!-- ===== Sisältö ===== -->
            <Grid Grid.Column="1">
                <!-- Live TV pidetään ladattuna, jotta VideoView-ikkuna säilyy -->
                <views:LiveTvView DataContext="{Binding LiveTv}"
                                  Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Equals}, ConverterParameter=LiveTv}" />
                <ContentControl x:Name="SectionHost" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
