<UserControl x:Class="Kanava.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.8">
                <GradientStop Color="#3A0A0D" Offset="0" />
                <GradientStop Color="#101010" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#E6181818"
                CornerRadius="14" Padding="36,32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Image Source="/Assets/Tollo.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Töllö" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Kirjaudu IPTV-palveluun (Xtream Codes)" Style="{StaticResource Dim}" Margin="0,0,0,26" />

                <TextBlock Text="Palvelimen osoite" Style="{StaticResource Dim}" Margin="0,0,0,6" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Käyttäjätunnus" Style="{StaticResource Dim}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Salasana" Style="{StaticResource Dim}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,18">
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
                    <TextBlock Text="••••••••  (tallennettu salasana)" Foreground="{StaticResource TextFaintBrush}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding ShowSavedPasswordHint, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <CheckBox Content="Muista kirjautuminen" IsChecked="{Binding RememberMe}" Margin="0,0,0,22" />

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" IsDefault="True" Padding="0,11">
                    <TextBlock Text="Kirjaudu sisään" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                </Button>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="Spin" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Dim}" />
                </StackPanel>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />

                <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,22,0,0" Foreground="{StaticResource TextFaintBrush}"
                           Text="Salasana tallennetaan salattuna (Windows DPAPI) vain tälle käyttäjätilille." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
