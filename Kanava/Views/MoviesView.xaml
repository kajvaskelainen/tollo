<UserControl x:Class="Kanava.Views.MoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Kanava.Services"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kategoriat -->
        <DockPanel Background="{StaticResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Text="KATEGORIAT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextFaintBrush}" Margin="16,22,0,4" />
            <ListBox x:Name="CategoryList" Style="{StaticResource CategoryList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ToolTip="Järjestä kategorioita raahaamalla tai hiiren oikealla painikkeella" ToolTipService.InitialShowDelay="1500" />
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Yläpalkki -->
            <Grid Margin="24,16,24,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Elokuvat" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} nimikettä}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="16,4,0,0" />
                </StackPanel>
                <TextBox Width="260" HorizontalAlignment="Right" Style="{StaticResource SearchBox}" Tag="Hae elokuvaa…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            </Grid>

            <!-- Julisteet -->
            <ListBox Grid.Row="1" Margin="18,0,8,8" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="OnDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="164,282" SpacingMode="Uniform" StretchItems="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="150" Height="268">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="225" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="6,6,0,0" Background="#262626" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="&#xE8B2;" Style="{StaticResource Icon}" FontSize="28" Foreground="#444" HorizontalAlignment="Center" />
                                    <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Poster}" svc:ImageCache.DecodeWidth="300" />
                                    <Border Background="#CC000000" CornerRadius="4" Padding="5,1" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Visibility="{Binding RatingText, Converter={StaticResource NullToVis}}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"><Run Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="Gold" /> <Run Text="{Binding RatingText, Mode=OneWay}" /></TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource HeartButton}" Tag="{Binding IsFavorite}" Background="#99000000" Margin="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Content="{Binding IsFavorite, Converter={StaticResource HeartGlyph}}"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="8,6" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" MaxHeight="34" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Lataus / virhe -->
            <TextBlock Grid.Row="1" Text="Ladataan elokuvia…" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="420" />
                <Button Style="{StaticResource GhostButton}" Content="Yritä uudelleen" Command="{Binding RetryCommand}" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Tietopaneeli -->
            <Border Grid.Row="0" Grid.RowSpan="2" Width="420" HorizontalAlignment="Right" Background="#181818"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="236">
                        <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Details.Backdrop}" svc:ImageCache.DecodeWidth="840" />
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00181818" Offset="0.3" />
                                    <GradientStop Color="#FF181818" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Background="#99000000" Foreground="White"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Command="{Binding CloseDetailsCommand}"
                                ToolTip="Sulje" AutomationProperties.Name="Sulje" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,-60,0,0">
                        <StackPanel Margin="24,0,24,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="144" CornerRadius="6" Background="#262626" ClipToBounds="True" Margin="0,0,16,0">
                                    <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Selected.Poster}" svc:ImageCache.DecodeWidth="300" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding Details.ReleaseDate, Mode=OneWay}" />  <Run Text="{Binding Details.Duration, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Details.Genre}" Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,18">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}" AutomationProperties.Name="Toista">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Toista" Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding ToggleFavoriteCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Selected.IsFavorite, Converter={StaticResource HeartGlyph}}" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                        <TextBlock Text="Suosikki" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Ladataan tietoja…" Style="{StaticResource Dim}" Visibility="{Binding IsDetailsLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Details.Plot}" TextWrapping="Wrap" LineHeight="20" Foreground="#DDD" />
                            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" Visibility="{Binding Details.Director, Converter={StaticResource NullToVis}}">
                                <Run Text="Ohjaaja: " Foreground="{StaticResource TextFaintBrush}" /><Run Text="{Binding Details.Director, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Visibility="{Binding Details.Cast, Converter={StaticResource NullToVis}}">
                                <Run Text="Näyttelijät: " Foreground="{StaticResource TextFaintBrush}" /><Run Text="{Binding Details.Cast, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
