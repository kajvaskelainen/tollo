<UserControl x:Class="Kanava.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Kortin sisällä painikkeille vaaleampi tausta -->
        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#2E2E2E" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Width" Value="170" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
        <StackPanel Margin="32,22,32,32" MaxWidth="760" HorizontalAlignment="Left" Width="760">
            <TextBlock Text="Asetukset" Style="{StaticResource H1}" Margin="0,0,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tili" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="Palvelin" Style="{StaticResource Label}" /><TextBlock Text="{Binding Server}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="Käyttäjä" Style="{StaticResource Label}" /><TextBlock Text="{Binding Account.Username}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="Tila" Style="{StaticResource Label}" /><TextBlock Text="{Binding Account.Status}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="Voimassa" Style="{StaticResource Label}" /><TextBlock Text="{Binding ExpiresText}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="Yhteydet" Style="{StaticResource Label}" /><TextBlock Text="{Binding ConnectionsText}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="Sisältö" Style="{StaticResource Label}" /><TextBlock Text="{Binding Counts}" /></StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Toisto" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Live-striimin muoto" Style="{StaticResource Dim}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="Fmt" Content="MPEG-TS (.ts) – suositeltu" IsChecked="{Binding IsTs}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="Fmt" Content="HLS (.m3u8)" IsChecked="{Binding IsHls}" />
                    </StackPanel>
                    <TextBlock Text="Kokeile HLS:ää, jos kanavat pätkivät tai eivät käynnisty." Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pienoissoitin" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Live TV jatkuu pienessä ikkunassa näytön kulmassa. Raahaa ikkunaa – se kiinnittyy lähimpään kulmaan. Tuplaklikkaus palauttaa Töllön." TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,0,0,12" />
                    <TextBlock Text="Avautuu" Style="{StaticResource Dim}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipMode" Content="Kun ikkuna pienennetään" IsChecked="{Binding PipOnMinimize}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipMode" Content="Pienennettäessä ja suljettaessa" IsChecked="{Binding PipOnClose}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipMode" Content="Vain napista (P)" IsChecked="{Binding PipManual}" />
                    </WrapPanel>
                    <TextBlock Text="Suljettaessa: ruksi piilottaa Töllön ja kanava jatkuu pienoissoittimessa. Ohjelma sulkeutuu, kun suljet pienoissoittimen." TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,8,0,14" />
                    <TextBlock Text="Paikka" Style="{StaticResource Dim}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipCorner" Content="Vasen yläkulma" IsChecked="{Binding PipTopLeft}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipCorner" Content="Oikea yläkulma" IsChecked="{Binding PipTopRight}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipCorner" Content="Vasen alakulma" IsChecked="{Binding PipBottomLeft}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipCorner" Content="Oikea alakulma" IsChecked="{Binding PipBottomRight}" />
                    </WrapPanel>
                    <TextBlock Text="Koko" Style="{StaticResource Dim}" Margin="0,14,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipSize" Content="Pieni" IsChecked="{Binding PipSmall}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipSize" Content="Keskikokoinen" IsChecked="{Binding PipMedium}" />
                        <RadioButton Style="{StaticResource TabItemRadio}" GroupName="PipSize" Content="Suuri" IsChecked="{Binding PipLarge}" />
                    </WrapPanel>
                    <CheckBox Content="Pysy aina muiden ikkunoiden päällä" IsChecked="{Binding PipTopmost}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Kanavalista ja ohjelmaopas" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding EpgStatus}" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                    <TextBlock Text="Opas päivittyy automaattisesti kerran vuorokaudessa ja tallennetaan välimuistiin. Lataa kanavalista uudelleen, jos palveluntarjoaja on lisännyt kanavia – piilotukset, järjestykset ja suosikit säilyvät." TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Lataa kanavalista uudelleen" Command="{Binding ReloadChannelsCommand}" Margin="0,0,10,0" />
                        <Button Content="Päivitä opas nyt" Command="{Binding RefreshEpgCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ChannelStatus}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" DataContext="{Binding EpgSources}">
                <StackPanel>
                    <TextBlock Text="Ulkoiset ohjelmaoppaat" Style="{StaticResource CardTitle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,0,0,12"
                               Text="Jos palveluntarjoajasi opas puuttuu tai on vajaa, lisää ilmainen XMLTV-opas. Kanavat yhdistetään nimen perusteella, ja ulkoista opasta käytetään kanaville, joille palveluntarjoajalla ei ole ohjelmatietoja. Testaa ensin, kuinka moneen kanavaasi lähde osuu." />

                    <TextBlock Text="Valmiit lähteet" Style="{StaticResource Dim}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Lisää" Margin="6,0,0,0" Padding="12,5"
                                            Command="{Binding DataContext.AddPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Lisää {0}}" />
                                    <Button DockPanel.Dock="Right" Content="Testaa" Padding="12,5"
                                            Command="{Binding DataContext.TestPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Testaa {0}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextFaintBrush}" FontSize="11.5"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Oma osoite tai tiedosto (.xml tai .xml.gz)" Style="{StaticResource Dim}" Margin="0,10,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Lisää" Margin="6,0,0,0" Padding="12,5" VerticalAlignment="Center" Command="{Binding AddNewCommand}" AutomationProperties.Name="Lisää oma lähde" />
                        <Button DockPanel.Dock="Right" Content="Testaa" Margin="6,0,0,0" Padding="12,5" VerticalAlignment="Center" Command="{Binding TestNewCommand}" AutomationProperties.Name="Testaa oma lähde" />
                        <TextBox Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="Oppaan osoite" />
                    </DockPanel>

                    <!-- Testiraportti -->
                    <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11"
                                        Command="{Binding CloseReportCommand}" AutomationProperties.Name="Sulje testin tulos" />
                                <Button DockPanel.Dock="Right" Content="Ota käyttöön" Padding="12,4" Margin="0,0,8,0" Command="{Binding AddReportedCommand}"
                                        Visibility="{Binding CanAddReported, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Ota testattu lähde käyttöön" />
                                <TextBlock Text="{Binding ReportTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                                       Visibility="{Binding ReportSummary, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding ReportMatched}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding ReportMatched, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding ReportUnmatched}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding ReportUnmatched, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Käytössä olevat -->
                    <TextBlock Text="Käytössä olevat lähteet" Style="{StaticResource Dim}" Margin="0,14,0,6"
                               Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Poista" Margin="6,0,0,0" Padding="12,5" Command="{Binding RemoveCommand}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Poista {0}}" />
                                    <Button DockPanel.Dock="Right" Content="Testaa" Padding="12,5" Command="{Binding TestCommand}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Testaa käytössä {0}}" />
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Käytössä"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Käytä {0}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastResult}" Foreground="{StaticResource TextFaintBrush}" FontSize="11.5"
                                                   Visibility="{Binding LastResult, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tiedot" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Tyhjennä katseluhistoria" Command="{Binding ClearHistoryCommand}" Margin="0,0,10,0" />
                        <Button Content="Poista väliaikaistiedostot" Command="{Binding ClearCacheCommand}" Margin="0,0,10,0" />
                        <Button Content="Avaa tietokansio" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataFolder}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" DataContext="{Binding Updates}">
                <StackPanel>
                    <TextBlock Text="Päivitykset" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Asennettu versio" Style="{StaticResource Label}" /><TextBlock Text="{Binding CurrentVersion}" />
                    </StackPanel>
                    <CheckBox Content="Tarkista päivitykset automaattisesti käynnistyksen yhteydessä" IsChecked="{Binding AutoCheck}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Tarkista päivitykset" Command="{Binding CheckNowCommand}" Margin="0,0,10,0" />
                        <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButton}" Visibility="{Binding Available, Converter={StaticResource NullToVis}}" />
                        <Button Content="Mitä uutta?" Command="{Binding OpenNotesCommand}" Visibility="{Binding Available, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" Margin="0,10,0,0" Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="Päivitykset ladataan ohjelman GitHub-sivulta, ja niiden eheys tarkistetaan ennen asennusta. Asetukset ja suosikit säilyvät."
                               Foreground="{StaticResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" Margin="4,0,0,12" />
            <TextBlock Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="4,0,0,0">
                <Run Text="Töllö" /> <Run Text="{Binding Version, Mode=OneWay}" /> <Run Text="· toisto: LibVLC" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
