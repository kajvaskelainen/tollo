<Window x:Class="Kanava.Views.ReminderToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Töllö – muistutus" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="Height" Width="360" Background="#1C1C1C" BorderBrush="#3A3A3A" BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="Manual">
    <Grid Margin="16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
        <StackPanel Grid.Column="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="24" Height="24"
                        Click="OnClose" AutomationProperties.Name="Sulje muistutus" />
                <TextBlock x:Name="Heading" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="ProgramTitle" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,2" />
            <TextBlock x:Name="ChannelText" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnWatch" AutomationProperties.Name="Katso muistutettu ohjelma">
                    <TextBlock Text="Katso" Foreground="White" />
                </Button>
                <Button Content="Sulje" Padding="14,6" Margin="8,0,0,0" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
