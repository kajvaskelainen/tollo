<Window x:Class="Kanava.Views.VodPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:Kanava.Views"
        Title="Töllö" Background="Black" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="True">
    <vlc:VideoView x:Name="Video" Background="Black">
        <!-- Ohjaimet VideoView:n sisältöalueessa (airspace) -->
        <Grid x:Name="Overlay" Background="#01000000" MouseMove="OnMouseMove" MouseLeftButtonDown="OnOverlayDown">
            <!-- Lataus / virhe -->
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#CCC" Text="Ladataan…" />
            <!-- OSD: äänen viive, kuvasuhde… -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0" Background="#CC000000" CornerRadius="8" Padding="14,7"
                    IsHitTestVisible="False" Visibility="{Binding Osd, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Osd}" Foreground="White" FontSize="14" />
            </Border>

            <!-- Seuraava jakso -->
            <Border x:Name="NextCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,150"
                    Background="#E6141414" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="18,14" MaxWidth="420">
                <StackPanel>
                    <TextBlock x:Name="NextTitle" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextCountdown" Foreground="#BBB" FontSize="12.5" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Toista nyt" Click="OnPlayNext" Padding="14,6" Margin="0,0,8,0" AutomationProperties.Name="Toista seuraava jakso" />
                        <Button Content="Peruuta" Click="OnCancelNext" Padding="14,6" AutomationProperties.Name="Peruuta seuraava jakso" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Yläpalkki -->
            <Border x:Name="TopBar" VerticalAlignment="Top" Padding="24,18,24,40">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="18" Width="40" Height="40" Foreground="White"
                            Click="OnClose" ToolTip="Takaisin (Esc)" AutomationProperties.Name="Takaisin" />
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- Alapalkki -->
            <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="32,48,32,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#DD000000" Offset="0.7" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Text="0:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd" PreviewMouseLeftButtonUp="OnSeekClick" />
                        <TextBlock x:Name="LenText" Grid.Column="2" Text="0:00" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xED3C;" Foreground="White" Width="40" Height="40" FontSize="18" Click="OnBack10" ToolTip="-10 s (←)" />
                            <Button x:Name="PlayPause" Style="{StaticResource IconButton}" Content="&#xE769;" Foreground="White" Width="48" Height="48" FontSize="22"
                                    Click="OnPlayPause" ToolTip="Toista / tauko (välilyönti)" Margin="6,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xED3D;" Foreground="White" Width="40" Height="40" FontSize="18" Click="OnFwd30" ToolTip="+30 s (→)" />
                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Foreground="White" Width="40" Height="40" FontSize="18"
                                    Click="OnNextClick" Margin="6,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Seuraava jakso" />
                        </StackPanel>
                        <!-- Lähetyksen tiedot keskellä -->
                        <StackPanel x:Name="StatsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                            <Border BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="0,0,8,0"
                                    Visibility="{Binding QualityBadge, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding QualityBadge}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding FormatText}" FontSize="11" Foreground="#BBB" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BitrateText}" FontSize="11" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding DataText}" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <local:PlaybackControls x:Name="Controls" HorizontalAlignment="Right" Foreground="White" SliderWidth="120" />

                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </vlc:VideoView>
</Window>
