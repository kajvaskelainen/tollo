<UserControl x:Class="Kanava.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Kanava.Services">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,26,0,12" />
        </Style>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Kanavakortti -->
        <DataTemplate x:Key="ChannelCard">
            <Button Style="{StaticResource GhostButton}" Padding="12,10" Margin="0,0,10,10" Width="240"
                    Command="{Binding DataContext.PlayLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    HorizontalContentAlignment="Stretch">
                <Grid Width="214">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="36" CornerRadius="5" Background="#2A2A2A" Margin="0,0,10,0">
                        <Image Margin="4" svc:ImageCache.Url="{Binding Logo}" svc:ImageCache.DecodeWidth="104" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Current.Title}" Style="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
        <StackPanel Margin="32,22,24,32">
            <TextBlock Text="Suosikit" Style="{StaticResource H1}" />

            <TextBlock Margin="0,30,0,0" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Text="Et ole vielä lisännyt suosikkeja. Lisää kanava, elokuva tai sarja suosikiksi sydän-painikkeella." />

            <!-- Live-kanavat -->
            <TextBlock Text="Live-kanavat" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding LiveFavorites}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChannelCard}" />
            <TextBlock Text="Ei suosikkikanavia" Foreground="{StaticResource TextFaintBrush}"
                       Visibility="{Binding LiveFavorites.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />

            <!-- Elokuvat -->
            <TextBlock Text="Elokuvat" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding MovieFavorites}" ItemsPanel="{StaticResource Wrap}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,12,12" Width="140"
                                Command="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <Border Width="140" Height="210" CornerRadius="6" Background="#2A2A2A" ClipToBounds="True">
                                    <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Poster}" svc:ImageCache.DecodeWidth="280" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="8,6,8,8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Ei suosikkielokuvia" Foreground="{StaticResource TextFaintBrush}"
                       Visibility="{Binding MovieFavorites.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />

            <!-- Sarjat -->
            <TextBlock Text="Sarjat" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding SeriesFavorites}" ItemsPanel="{StaticResource Wrap}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,12,12" Width="140"
                                Command="{Binding DataContext.OpenSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <Border Width="140" Height="210" CornerRadius="6" Background="#2A2A2A" ClipToBounds="True">
                                    <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Cover}" svc:ImageCache.DecodeWidth="280" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="8,6,8,8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Ei suosikkisarjoja" Foreground="{StaticResource TextFaintBrush}"
                       Visibility="{Binding SeriesFavorites.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />

            <!-- Historia -->
            <Grid Margin="0,26,0,12">
                <TextBlock Text="Viimeksi katsotut kanavat" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="12,5" Content="Tyhjennä historia"
                        Command="{Binding ClearHistoryCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding History}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChannelCard}" />
            <TextBlock Text="Historia on tyhjä" Foreground="{StaticResource TextFaintBrush}"
                       Visibility="{Binding History.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
