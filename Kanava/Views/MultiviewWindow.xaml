<Window x:Class="Kanava.Views.MultiviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monikatselu – Töllö" Width="1280" Height="760" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kanavalista -->
        <DockPanel x:Name="Side" Margin="12,12,6,12">
            <TextBlock DockPanel.Dock="Top" Text="Monikatselu" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,4" />
            <TextBlock DockPanel.Dock="Top" x:Name="Hint" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" Margin="2,0,0,10"
                       Text="Kaksoisklikkaa kanavaa: se avautuu valittuun ruutuun. Klikkaa ruutua valitaksesi sen – ääni kuuluu valitusta. F11 = koko näyttö." />
            <TextBox DockPanel.Dock="Top" x:Name="Search" Style="{StaticResource SearchBox}" Tag="Hae kanavaa…" Margin="0,0,0,8"
                     TextChanged="OnSearch" AutomationProperties.Name="Hae kanavaa monikatseluun" />
            <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="2,8,0,0" />
            <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MouseDoubleClick="OnChannelDoubleClick" KeyDown="OnChannelKey"
                     AutomationProperties.Name="Monikatselun kanavat" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NumberText}" Width="34" Foreground="{StaticResource TextFaintBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 2×2-ruudukko (ruudut luodaan koodissa) -->
        <UniformGrid x:Name="Tiles" Grid.Column="1" Rows="2" Columns="2" Margin="6,12,12,12" />
    </Grid>
</Window>
