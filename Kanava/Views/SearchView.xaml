<UserControl x:Class="Kanava.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Kanava.Services">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,12" />
        </Style>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource BgBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
            <TextBlock Text="Haku" Style="{StaticResource H1}" />
            <TextBox x:Name="QueryBox" Style="{StaticResource SearchBox}" Tag="Hae kanavia, elokuvia ja sarjoja…" Margin="0,16,0,0" MaxWidth="640"
                     HorizontalAlignment="Left" Width="640" FontSize="15"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" Margin="4,14,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,24,32">
                <!-- Kanavat -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Channels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Live-kanavat" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Channels}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Padding="12,10" Margin="0,0,10,10" Width="240"
                                        Command="{Binding DataContext.PlayLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Grid Width="214">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52" Height="36" CornerRadius="5" Background="#2A2A2A" Margin="0,0,10,0">
                                            <Image Margin="4" svc:ImageCache.Url="{Binding Logo}" svc:ImageCache.DecodeWidth="104" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Current.Title}" Style="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Elokuvat -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Movies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Elokuvat" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Movies}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,12,12" Width="130"
                                        Command="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Width="130" Height="195" CornerRadius="6" Background="#2A2A2A" ClipToBounds="True">
                                            <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Poster}" svc:ImageCache.DecodeWidth="260" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="8,6,8,8" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Sarjat -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Series.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Sarjat" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Series}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,12,12" Width="130"
                                        Command="{Binding DataContext.OpenSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Width="130" Height="195" CornerRadius="6" Background="#2A2A2A" ClipToBounds="True">
                                            <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Cover}" svc:ImageCache.DecodeWidth="260" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="8,6,8,8" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
