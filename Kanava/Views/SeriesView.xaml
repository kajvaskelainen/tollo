<UserControl x:Class="Kanava.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Kanava.Services"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Background="{StaticResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Text="KATEGORIAT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextFaintBrush}" Margin="16,22,0,4" />
            <ListBox x:Name="CategoryList" Style="{StaticResource CategoryList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ToolTip="Järjestä kategorioita raahaamalla tai hiiren oikealla painikkeella" ToolTipService.InitialShowDelay="1500" />
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="24,16,24,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sarjat" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} sarjaa}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="16,4,0,0" />
                </StackPanel>
                <TextBox Width="260" HorizontalAlignment="Right" Style="{StaticResource SearchBox}" Tag="Hae sarjaa…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            </Grid>

            <ListBox Grid.Row="1" Margin="18,0,8,8" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="164,282" SpacingMode="Uniform" StretchItems="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="150" Height="268">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="225" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="6,6,0,0" Background="#262626" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="28" Foreground="#444" HorizontalAlignment="Center" />
                                    <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Cover}" svc:ImageCache.DecodeWidth="300" />
                                    <Button Style="{StaticResource HeartButton}" Tag="{Binding IsFavorite}" Background="#99000000" Margin="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Content="{Binding IsFavorite, Converter={StaticResource HeartGlyph}}"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="8,6" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" MaxHeight="34" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="Ladataan sarjoja…" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="420" />
                <Button Style="{StaticResource GhostButton}" Content="Yritä uudelleen" Command="{Binding RetryCommand}" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Sarjan tiedot + jaksot -->
            <Border Grid.Row="0" Grid.RowSpan="2" Width="460" HorizontalAlignment="Right" Background="#181818"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="24,20,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="84" Height="126" CornerRadius="6" Background="#262626" ClipToBounds="True" Margin="0,0,16,0">
                            <Image Stretch="UniformToFill" svc:ImageCache.Url="{Binding Selected.Cover}" svc:ImageCache.DecodeWidth="300" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.Genre}" Style="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,6" Command="{Binding ToggleFavoriteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Selected.IsFavorite, Converter={StaticResource HeartGlyph}}" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Suosikki" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top"
                                Command="{Binding CloseDetailsCommand}" ToolTip="Sulje" AutomationProperties.Name="Sulje" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Margin="24,16,24,0" TextWrapping="Wrap" Foreground="#DDD" LineHeight="20" MaxHeight="100" TextTrimming="WordEllipsis"
                               Text="{Binding Selected.Plot}" />

                    <!-- Kaudet -->
                    <ListBox DockPanel.Dock="Top" Margin="20,16,20,8" ItemsSource="{Binding Details.Seasons}" SelectedItem="{Binding SelectedSeason}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="15" Padding="14,6" Margin="0,0,6,4" Background="{StaticResource SurfaceBrush}">
                                                <TextBlock x:Name="t" Text="{Binding Name}" Foreground="{StaticResource TextDimBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="t" Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock DockPanel.Dock="Top" Margin="24,8" Text="Ladataan jaksoja…" Style="{StaticResource Dim}"
                               Visibility="{Binding IsDetailsLoading, Converter={StaticResource BoolToVis}}" />

                    <!-- Jaksot -->
                    <ListBox Margin="16,0,8,16" ItemsSource="{Binding SelectedSeason.Episodes}" ItemContainerStyle="{StaticResource PlainItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Plot}" Style="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="White" Background="{StaticResource AccentBrush}"
                                            Margin="10,0,0,0" ToolTip="Toista"
                                            Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
