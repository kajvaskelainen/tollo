<UserControl x:Class="Kanava.Views.LiveTvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:svc="clr-namespace:Kanava.Services"
             xmlns:ctl="clr-namespace:Kanava.Controls"
             xmlns:local="clr-namespace:Kanava.Views"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <UserControl.Resources>
        <!-- Piilotetaan koko näytön tilassa -->
        <Style x:Key="HideInFullscreen" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.44*" MinHeight="220" />
            <RowDefinition Height="0.56*" />
        </Grid.RowDefinitions>

        <!-- ===== Kategoriapalsta ===== -->
        <DockPanel Grid.RowSpan="3" Background="{StaticResource PanelBrush}" Style="{StaticResource HideInFullscreen}">
            <TextBlock DockPanel.Dock="Top" Text="KATEGORIAT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextFaintBrush}" Margin="16,22,0,4" />
            <ListBox x:Name="CategoryList" Style="{StaticResource CategoryList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ToolTip="Järjestä kategorioita raahaamalla tai hiiren oikealla painikkeella" ToolTipService.InitialShowDelay="1500" />
        </DockPanel>

        <!-- ===== Yläpalkki ===== -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="24,16,24,12" Style="{StaticResource HideInFullscreen}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Live TV" Style="{StaticResource H1}" VerticalAlignment="Center" Margin="0,0,28,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource TabItemRadio}" GroupName="LiveTab" Content="Kanavakortit"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}" />
                <RadioButton Style="{StaticResource TabItemRadio}" GroupName="LiveTab" Content="TV-opas (EPG)"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <!-- Järjestystilan painikkeet -->
                <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,0" Command="{Binding ResetChannelOrderCommand}"
                        Visibility="{Binding IsReorderMode, Converter={StaticResource BoolToVis}}" ToolTip="Palauttaa tämän kategorian kanavat palvelimen järjestykseen">
                    <TextBlock Text="Palauta oletusjärjestys" />
                </Button>
                <Button Command="{Binding ToggleReorderCommand}" Padding="12,6" AutomationProperties.Name="Järjestä">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReorderMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Järjestä" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReorderMode}" Value="True">
                                            <Setter Property="Text" Value="Valmis" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Grid.Column="2" Style="{StaticResource SearchBox}" Tag="Hae kanavaa…"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </Grid>

        <!-- ===== Esikatselusoitin ===== -->
        <Border x:Name="PlayerHost" Background="Black">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Ei paikallisia arvoja: muuten DataTrigger ei voisi ohittaa niitä -->
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Margin" Value="24,0,16,0" />
                    <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectWidth}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="3" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="3" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Width" Value="NaN" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <vlc:VideoView x:Name="Video" Background="Black">
                <!-- VideoView:n sisältö piirtyy omaan ikkunaansa videon päälle (airspace-ratkaisu) -->
                <Grid x:Name="Overlay" MouseLeftButtonDown="OnOverlayMouseDown" MouseMove="OnOverlayMouseMove">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- Lähes läpinäkyvä tausta, jotta klikkaukset osuvat overlayhin -->
                            <Setter Property="Background" Value="#01000000" />
                            <Style.Triggers>
                                <!-- Ennen toistoa VLC:n ikkuna on valkoinen – peitetään -->
                                <DataTrigger Binding="{Binding PlayingChannel}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#141414" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ctl:CornerMask Fill="{StaticResource BgBrush}">
                        <ctl:CornerMask.Style>
                            <Style TargetType="ctl:CornerMask">
                                <Setter Property="Radius" Value="12" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                        <Setter Property="Radius" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:CornerMask.Style>
                    </ctl:CornerMask>

                    <!-- Ei kanavaa valittuna -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding PlayingChannel, Converter={StaticResource NullToVis}, ConverterParameter=!}">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="#555" />
                        <TextBlock Text="Valitse kanava" Foreground="#888" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>


                    <!-- Koko näytön tietopalkki -->
                    <Border x:Name="FullscreenBar" VerticalAlignment="Bottom" Padding="40,28,40,32" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#DD000000" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="96" Height="64" Margin="0,0,20,0" svc:ImageCache.Url="{Binding PlayingChannel.Logo}" svc:ImageCache.DecodeWidth="192" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlayingChannel.Name}" FontSize="24" FontWeight="Bold" />
                                    <Border Style="{StaticResource LiveBadge}" Margin="12,0,0,0">
                                        <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding NowProgram.Title}" FontSize="17" Margin="0,4,0,8" />
                                <ProgressBar Value="{Binding NowProgress, Mode=OneWay}" Width="420" HorizontalAlignment="Left"
                                             Visibility="{Binding NowProgram, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                            <!-- Hallinta + lähetyksen tiedot -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <local:PlaybackControls x:Name="FullscreenControls" DataContext="{Binding Playback}" Foreground="White" SliderWidth="130" />
                                    <Button Style="{StaticResource IconButton}" Foreground="White" Content="&#xE73F;" Margin="8,0,0,0"
                                            Command="{Binding ToggleFullscreenCommand}" ToolTip="Poistu koko näytöstä (Esc)"
                                            AutomationProperties.Name="Poistu koko näytöstä" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" DataContext="{Binding Playback}"
                                            Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                                    <Border BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="0,0,8,0"
                                            Visibility="{Binding QualityBadge, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding QualityBadge}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding FormatText}" FontSize="11" Foreground="#BBB" VerticalAlignment="Center" />
                                    <TextBlock FontSize="11" Foreground="#BBB" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Visibility="{Binding BitrateText, Converter={StaticResource NullToVis}}">
                                        <Run Text="&#xE896;" FontFamily="{StaticResource IconFont}" /> <Run Text="{Binding BitrateText, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DataText}" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" Margin="0,6,0,0" FontSize="11" Foreground="#888"
                                           Text="Esc palaa · tuplaklikkaus pienentää · M mykistää · ↑↓ äänenvoimakkuus" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Border>

        <!-- ===== Tietokortti ===== -->
        <Border Grid.Row="1" Grid.Column="2" Margin="0,0,24,0" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                Padding="22,20" Style="{StaticResource HideInFullscreen}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding PlayingChannel, Converter={StaticResource NullToVis}, ConverterParameter=!}">
                    <TextBlock Text="Ei kanavaa valittuna" Style="{StaticResource Dim}" HorizontalAlignment="Center" />
                    <TextBlock Text="Klikkaa kanavaa esikatsellaksesi, tuplaklikkaa koko näyttöön." Foreground="{StaticResource TextFaintBrush}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <DockPanel Visibility="{Binding PlayingChannel, Converter={StaticResource NullToVis}}">
                    <!-- Kanava -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="48" CornerRadius="6" Background="#262626" Margin="0,0,14,0">
                            <Image Margin="6" svc:ImageCache.Url="{Binding PlayingChannel.Logo}" svc:ImageCache.DecodeWidth="144" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayingChannel.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Style="{StaticResource LiveBadge}">
                                    <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding PlayingChannel.NumberText, StringFormat=Kanava {0}}" Style="{StaticResource Dim}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButton}" ToolTip="Koko näyttö (F)" AutomationProperties.Name="Koko näyttö"
                                    Command="{Binding ToggleFullscreenCommand}" Content="&#xE740;" />
                            <Button Style="{StaticResource HeartButton}" Tag="{Binding PlayingChannel.IsFavorite}" ToolTip="Suosikki"
                                    AutomationProperties.Name="Suosikki"
                                    Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding PlayingChannel}"
                                    Content="{Binding PlayingChannel.IsFavorite, Converter={StaticResource HeartGlyph}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Hallinta (esikatselu) -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                        <StackPanel>
                            <local:PlaybackControls DataContext="{Binding Playback}" Foreground="{StaticResource TextDimBrush}" SliderWidth="70" Margin="-6,0,0,0" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       DataContext="{Binding Playback}" Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                                <Run Text="{Binding FormatText, Mode=OneWay}" />  <Run Text="{Binding BitrateText, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Seuraavaksi -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                            Visibility="{Binding NextProgram, Converter={StaticResource NullToVis}}">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="Seuraavaksi:" Foreground="{StaticResource TextDimBrush}" />
                            <Run Text="{Binding NextProgram.Start, StringFormat=HH:mm, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                            <Run Text="{Binding NextProgram.Title, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <!-- Nyt -->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding NowProgram, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding NowProgram.Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding NowProgram.TimeText}" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,12,0" />
                            <ProgressBar Grid.Column="1" Value="{Binding NowProgress, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ohjelmatietoja ei saatavilla" Style="{StaticResource Dim}"
                               Visibility="{Binding NowProgram, Converter={StaticResource NullToVis}, ConverterParameter=!}" />
                    <TextBlock Text="{Binding NowProgram.Description}" Style="{StaticResource Dim}" TextWrapping="Wrap"
                               TextTrimming="WordEllipsis" LineHeight="19" Margin="0,0,0,12" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== Alaosa: kanavakortit / EPG ===== -->
        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="24,18,14,12" Style="{StaticResource HideInFullscreen}">
            <!-- Järjestystilan ohje (rivin yläreunan marginaalissa) -->
            <TextBlock VerticalAlignment="Top" Margin="6,-17,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding IsReorderMode, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Järjestystila: raahaa kanavakortteja ja vasemman reunan kategorioita uuteen paikkaan. Oikea hiiren painike = siirrä alkuun/loppuun." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanReorderChannels}" Value="False">
                                <Setter Property="Text" Value="Tätä listaa ei voi järjestää (historia tai haku käytössä). Kategorioita voi silti raahata." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Kanavakortit -->
            <ListBox x:Name="Cards" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                     ItemContainerStyle="{StaticResource CardItem}"
                     Visibility="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="OnCardDoubleClick"
                     ContextMenuOpening="OnCardMenu">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="250,86" SpacingMode="None" StretchItems="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="240" Height="76" Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="40" CornerRadius="5" Background="#2A2A2A" VerticalAlignment="Top" Margin="0,2,10,0">
                                <Grid>
                                    <Image Margin="4" svc:ImageCache.Url="{Binding Logo}" svc:ImageCache.DecodeWidth="112" />
                                    <!-- Raahauskahva järjestystilassa -->
                                    <Border CornerRadius="5" Background="#CC000000" Cursor="SizeAll"
                                            Visibility="{Binding DataContext.IsReorderMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE76F;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Current.Title}" Style="{StaticResource Dim}" FontSize="12" Margin="0,3,0,6" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}" Height="3"
                                             Visibility="{Binding Current, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HeartButton}" Tag="{Binding IsFavorite}" VerticalAlignment="Top" Margin="2,-6,-8,0"
                                    Content="{Binding IsFavorite, Converter={StaticResource HeartGlyph}}" ToolTip="Suosikki"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- EPG-ruudukko (vaihe 3) -->
            <DockPanel Margin="5,5,10,0" Visibility="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding GuideStatus}" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center"
                               Text="Klikkaa = esikatselu · tuplaklikkaa = koko näyttö · vedä tai Shift+rulla = vieritä aikaa" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="12,5" Click="OnGuideNow">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Nyt" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <ctl:EpgGrid x:Name="Guide" Channels="{Binding Channels}" Epg="{Binding Session.Epg}"
                                 SelectedChannel="{Binding SelectedChannel}" Version="{Binding GuideVersion}"
                                 ActivateCommand="{Binding PlayFullscreenCommand}" FavoriteCommand="{Binding ToggleFavoriteCommand}" />
                </Border>
            </DockPanel>

            <TextBlock Text="Ei kanavia tässä kategoriassa" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Channels.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />
        </Grid>
    </Grid>
</UserControl>
